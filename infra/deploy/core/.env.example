# infra/deploy/sakura/.env のテンプレート。cp して埋めること (.env は gitignore 済み)。

# 採掘報酬の受取先 (自分の SS58 アドレスに変える)
ANARCHY_COINBASE=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY

# tor 起動後に取得する値
#   docker compose exec tor cat /var/lib/tor/anarchy-storage/hostname
STORAGE1_PUBLIC_URL=http://CHANGE_ME.onion:3030
STORAGE2_PUBLIC_URL=http://CHANGE_ME.onion:3031
STORAGE3_PUBLIC_URL=http://CHANGE_ME.onion:3032

# chain-1 起動後に取得する値
#   docker compose logs chain-1 | grep "Local node identity"
CHAIN1_PEER_ID=CHANGE_ME

# イメージ (省略時は ghcr の latest)
# ANARCHY_NODE_IMAGE=ghcr.io/moriwakiyusuke/anarchy-node:latest
# ANARCHY_STORAGE_IMAGE=ghcr.io/moriwakiyusuke/anarchy-storage-node:latest
