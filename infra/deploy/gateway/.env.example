# infra/deploy/gateway/.env のテンプレート。cp して埋めること (.env は gitignore 済み)。

# core ホストの chain onion と chain-1 の peer ID。
#   core 側で:
#     docker compose exec tor cat /var/lib/tor/anarchy-chain/hostname
#     docker compose logs chain-1 | grep "Local node identity"
CORE_CHAIN_ONION=CHANGE_ME.onion
CORE_CHAIN_PEER_ID=CHANGE_ME

# フロント (Cloudflare Workers) のオリジン。別オリジンになるので CORS が要る。
# ANARCHY_RPC_CORS=https://anarchy-frontend.example.workers.dev

# ANARCHY_NODE_IMAGE=ghcr.io/moriwakiyusuke/anarchy-node:latest
