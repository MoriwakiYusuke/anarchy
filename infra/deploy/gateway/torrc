# gateway 用 torrc (gen.py が生成)
#
# HiddenServicePort の転送先にホスト名は使えない (IP かソケットのみ)。

DataDirectory /var/lib/tor
RunAsDaemon 0
Log notice stdout

SocksPort 127.0.0.1:9050 IsolateClientAddr IsolateSOCKSAuth

# ---- Hidden Service: ストレージ 3 台 ----
HiddenServiceDir /var/lib/tor/anarchy-storage
HiddenServiceVersion 3
HiddenServicePort 3030 172.30.0.31:3030
HiddenServicePort 3031 172.30.0.32:3031
HiddenServicePort 3032 172.30.0.33:3032

ClientUseIPv6 1
ClientPreferIPv6ORPort 0
SafeLogging 1
