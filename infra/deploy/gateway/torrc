# GCP 用 torrc
#
# GCP はチェーン 1 台のみ。さくら/AWS へは outbound だけなので
# Hidden Service は不要 (向こうから dial されることがない)。

DataDirectory /var/lib/tor
RunAsDaemon 0
Log notice stdout

SocksPort 127.0.0.1:9050 IsolateClientAddr IsolateSOCKSAuth

# ---- Hidden Service: ストレージ 5 台 ----
HiddenServiceDir /var/lib/tor/anarchy-storage
HiddenServiceVersion 3
HiddenServicePort 3030 172.30.0.31:3030
HiddenServicePort 3031 172.30.0.32:3031
HiddenServicePort 3032 172.30.0.33:3032
HiddenServicePort 3033 172.30.0.34:3033
HiddenServicePort 3034 172.30.0.35:3034

ClientUseIPv6 1
ClientPreferIPv6ORPort 0
SafeLogging 1
